#version 450 core

#cmakedefine PREFIX_OUTPUT

#cmakedefine DO_XOR 

layout (local_size_x = 256) in;

#ifdef PREFIX_OUTPUT
layout(set = 0, binding = @OUTPUT_BINDING@, std430) buffer TileOffsets {
  uint @PREFIXED_OUTPUT@[];
};
#else 
layout(set = 0, binding = @INPUT_BINDING@, std430) buffer TileOffsets {
  uint @INPUT@[];
};
#endif

layout(set = 0, binding = 3, std430) buffer SubgroupTmp {
  uint subgroup_tmp[];
};

layout(push_constant) uniform push_constant {
  uint screen_w,  screen_h;
  uint n_tiles_x, n_tiles_y;
  uint tile_size;

  uint n_segments;
  uint n_paths;

  uint fill_rule;
} pc;


void main() {
  uint gid = gl_GlobalInvocationID.x;
  uint wid = gl_WorkGroupID.x;

  if(gid >= pc.n_tiles_x * pc.n_tiles_y) return;

#ifdef DO_XOR 
  @PREFIXED_OUTPUT@[gid] ^= subgroup_tmp[gid / 256];
#else 
  @PREFIXED_OUTPUT@[gid] += subgroup_tmp[gid / 256];
#endif 
}
