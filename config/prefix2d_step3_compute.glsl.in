#version 450 core

#cmakedefine PREFIX_OUTPUT
#cmakedefine DO_XOR 

layout (local_size_x = 64) in;

layout(set = 0, binding = 8, std430) buffer SubgroupTmp {
    uint subgroup_tmp[];
};

#ifdef PREFIX_OUTPUT
layout(set = 0, binding = @OUTPUT_BINDING@, std430) buffer TileOffsets {
  uint @PREFIXED_OUTPUT@[];
};
#else 
layout(set = 0, binding = @INPUT_BINDING@, std430) buffer TileOffsets {
  uint @INPUT@[];
};
#endif

layout(push_constant) uniform push_constant {
  uint screen_w,  screen_h;
  uint n_tiles_x, n_tiles_y;
  uint n_macrotiles_x, n_macrotiles_y;
  uint tile_size, macrotile_size;

  uint n_segments;
  uint n_paths;

  uint fill_rule;
} pc;

void main() {
  uint block = gl_WorkGroupID.x;
  uint row = gl_WorkGroupID.y;
  uint lane = gl_LocalInvocationID.x;
  uint blocks_per_row = (pc.@DIM_X@ + 63) / 64;

  uint x = block * 64 + lane;

  uint idx = row * pc.@DIM_X@ + x;

  uint block_idx = row * blocks_per_row + block;

  bool is_active = block_idx < blocks_per_row * pc.@DIM_Y@ && x < pc.@DIM_X@;
  if(is_active) {
#ifdef DO_XOR
    @PREFIXED_OUTPUT@[idx] ^= subgroup_tmp[block_idx];
#else 
    @PREFIXED_OUTPUT@[idx] += subgroup_tmp[block_idx];
#endif 
  }
}

